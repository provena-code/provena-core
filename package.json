{
  "name": "provena",
  "displayName": "Provena Core",
  "description": "",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "cli": "node --enable-source-maps dist/App.js",
