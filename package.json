    "test": "vitest"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "devalue": "^5.6.4",
    "diff": "^8.0.2",
    "zod": "^4.1.12"
  }
}
